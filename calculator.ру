def ADD(x, y):
    """Сложение двух чисел"""
    return x+y

def subtract(a,b):
    """Вычитание двух чисел"""
    return a - b

def multiply(a, b):
    """Умножение двух чисел"""
    c = a * b
    return c

def divide(a, b):
    """Деление двух чисел"""
    return a / b

def main():
    """Основная функция с консольным интерфейсом"""
    print("Калькулятор")
    
    while True:
        try:
            user_input = input("Введите выражение: ")
            
            if user_input == "выход":
                break
            
            parts = user_input.split()
            if len(parts) < 3:
                print("Ошибка формата")
                continue
            
            a = float(parts[0])
            operator = parts[1]
            b = float(parts[2])
            
            r = 0
            if operator == '+':
                r = ADD(a, b)
            elif operator == '-':
                r = subtract(a, b)
            elif operator == '*':
                r = multiply(a, b)
            elif operator == '/':
                r = divide(a, b)
            else:
                print("Неизвестная операция")
                continue
            
            if r > 100:
                print("Большой результат")
            print(f"Ответ: {r}")
            
        except:
            print("Ошибка")

if name == "__main__":
    main()
